#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i;
    int request[100];
    int head;
    int total_head_movement = 0;

    printf("Enter the number of disk requests: ");
    scanf("%d", &n);

    printf("Enter the disk request queue:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &request[i]);
    }

    printf("Enter the initial head position: ");
    scanf("%d", &head);

    printf("\nFCFS Disk Scheduling Order:\n");
    printf("%d", head);

    for (i = 0; i < n; i++)
    {
        total_head_movement += abs(head - request[i]);
        head = request[i];

        printf(" -> %d", head);
    }

    printf("\n\nTotal Head Movement = %d cylinders\n", total_head_movement);

    return 0;
}
