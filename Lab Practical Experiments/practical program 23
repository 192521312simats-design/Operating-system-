#include <stdio.h>
#include <string.h>

#define USERS 10
#define FILES 20

struct User {
    char name[30];
    char files[FILES][30];
    int fileCount;
};

int main()
{
    struct User users[USERS];
    int userCount = 0;
    int choice;
    char username[30], filename[30];

    while (1) {
        printf("\n1. Create User");
        printf("\n2. Create File");
        printf("\n3. Search File");
        printf("\n4. Display User Files");
        printf("\n5. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (userCount >= USERS) {
                printf("Maximum users reached\n");
                continue;
            }

            printf("Enter user name: ");
            scanf("%s", users[userCount].name);
            users[userCount].fileCount = 0;
            userCount++;

            printf("User created successfully\n");
        }

        else if (choice == 2) {
            int found = -1;

            printf("Enter user name: ");
            scanf("%s", username);

            for (int i = 0; i < userCount; i++) {
                if (strcmp(users[i].name, username) == 0) {
                    found = i;
                    break;
                }
            }

            if (found == -1) {
                printf("User not found\n");
            } else {
                printf("Enter file name: ");
                scanf("%s", filename);

                strcpy(users[found].files[users[found].fileCount],
                       filename);
                users[found].fileCount++;

                printf("File created successfully\n");
            }
        }

        else if (choice == 3) {
            int found = -1;
            int fileFound = 0;

            printf("Enter user name: ");
            scanf("%s", username);

            for (int i = 0; i < userCount; i++) {
                if (strcmp(users[i].name, username) == 0) {
                    found = i;
                    break;
                }
            }

            if (found == -1) {
                printf("User not found\n");
                continue;
            }

            printf("Enter file name: ");
            scanf("%s", filename);

            for (int i = 0; i < users[found].fileCount; i++) {
                if (strcmp(users[found].files[i], filename) == 0) {
                    fileFound = 1;
                    break;
                }
            }

            if (fileFound)
                printf("File found\n");
            else
                printf("File not found\n");
        }

        else if (choice == 4) {
            int found = -1;

            printf("Enter user name: ");
            scanf("%s", username);

            for (int i = 0; i < userCount; i++) {
                if (strcmp(users[i].name, username) == 0) {
                    found = i;
                    break;
                }
            }

            if (found == -1) {
                printf("User not found\n");
            } else {
                printf("\nFiles of %s:\n", username);

                for (int i = 0; i < users[found].fileCount; i++)
                    printf("%s\n", users[found].files[i]);
            }
        }

        else if (choice == 5) {
            return 0;
        }

        else {
            printf("Invalid choice\n");
        }
    }
}
