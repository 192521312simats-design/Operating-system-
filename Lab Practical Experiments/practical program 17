#include <stdio.h>
int main()
{
    int i, j, k;
    int p = 5, r = 3;
    int alloc[5][3] = {
        {0,1,0},
        {2,0,0},
        {3,0,2},
        {2,1,1},
        {0,0,2}
    };
   int max[5][3] = {
        {7,5,3},
        {3,2,2},
        {9,0,2},
        {2,2,2},
        {4,3,3}
    };

    int avail[3] = {3,3,2};

    int need[5][3];
    int finish[5]={0};

    printf("Need Matrix:\n");

    for(i=0;i<p;i++)
    {
        for(j=0;j<r;j++)
        {
            need[i][j]=max[i][j]-alloc[i][j];
            printf("%d ",need[i][j]);
        }
        printf("\n");
    }

    printf("\nSafe Sequence: ");

    for(k=0;k<p;k++)
    {
        for(i=0;i<p;i++)
        {
            if(finish[i]==0)
            {
                int flag=1;

                for(j=0;j<r;j++)
                {
                    if(need[i][j]>avail[j])
                    {
                        flag=0;
                        break;
                    }
                }

                if(flag)
                {
                    printf("P%d ",i);

                    for(j=0;j<r;j++)
                        avail[j]+=alloc[i][j];

                    finish[i]=1;
                }
            }
        }
    }

    return 0;
}
