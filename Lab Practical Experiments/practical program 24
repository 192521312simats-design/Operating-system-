#include <stdio.h>

struct Employee {
    int id;
    char name[30];
    float salary;
};

int main()
{
    FILE *fp;
    struct Employee emp;
    int n, id;

    fp = fopen("employee.dat", "wb");

    if (fp == NULL) {
        printf("Unable to create file\n");
        return 1;
    }

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("\nEnter Employee %d ID: ", i + 1);
        scanf("%d", &emp.id);

        printf("Enter Name: ");
        scanf("%s", emp.name);

        printf("Enter Salary: ");
        scanf("%f", &emp.salary);

        fwrite(&emp, sizeof(emp), 1, fp);
    }

    fclose(fp);

    fp = fopen("employee.dat", "rb");

    if (fp == NULL) {
        printf("Unable to open file\n");
        return 1;
    }

    printf("\nEnter Employee ID to access: ");
    scanf("%d", &id);

    /*
       Since records are stored sequentially,
       search each record for the requested ID.
    */
    while (fread(&emp, sizeof(emp), 1, fp) == 1) {
        if (emp.id == id) {
            printf("\nEmployee Found\n");
            printf("ID     : %d\n", emp.id);
            printf("Name   : %s\n", emp.name);
            printf("Salary : %.2f\n", emp.salary);
            fclose(fp);
            return 0;
        }
    }

    printf("Employee not found\n");

    fclose(fp);

    return 0;
}
