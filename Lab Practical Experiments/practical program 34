#include <stdio.h>

int main() {
    int records[50];
    int n, i, pos;

    printf("Enter number of records: ");
    scanf("%d", &n);

    printf("Enter records:\n");
    for (i = 0; i < n; i++) {
        printf("Record %d: ", i + 1);
        scanf("%d", &records[i]);
    }

    printf("\nSequentially Stored Records:\n");
    for (i = 0; i < n; i++)
        printf("Record %d = %d\n", i + 1, records[i]);

    printf("\nEnter record number to access: ");
    scanf("%d", &pos);

    if (pos >= 1 && pos <= n) {
        printf("\nReading records sequentially...\n");

        for (i = 0; i < pos; i++)
            printf("Reading Record %d = %d\n", i + 1, records[i]);

        printf("Requested Record = %d\n", records[pos - 1]);
    } else {
        printf("Invalid record number.\n");
    }

    return 0;
}
