#include <stdio.h>

int main()
{
    int pages[100], frames[10], recent[10];
    int n, f, i, j, k;
    int faults = 0, time = 0;
    int found, pos, min;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
        recent[i] = 0;
    }

    for (i = 0; i < n; i++)
    {
        time++;
        found = 0;

        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                recent[j] = time;
                break;
            }
        }

        if (!found)
        {
            faults++;
            pos = -1;

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            if (pos == -1)
            {
                min = recent[0];
                pos = 0;

                for (k = 1; k < f; k++)
                {
                    if (recent[k] < min)
                    {
                        min = recent[k];
                        pos = k;
                    }
                }
            }

            frames[pos] = pages[i];
            recent[pos] = time;
        }

        printf("Page %d: ", pages[i]);

        for (j = 0; j < f; j++)
        {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);

    return 0;
}
