int main() {
    int pageTable[20];
    int pages, page, offset, pageSize;

    printf("Enter Number of Pages: ");
    scanf("%d", &pages);

    printf("Enter Page Size: ");
    scanf("%d", &pageSize);

    printf("Enter Frame Number for each Page\n");

    for (int i = 0; i < pages; i++) {
        printf("Page %d: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Logical Page Number: ");
    scanf("%d", &page);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (page >= pages || offset >= pageSize) {
        printf("Invalid Address\n");
    } else {
        printf("\nPage %d maps to Frame %d\n", page, pageTable[page]);
        printf("Physical Address = %d\n",
               pageTable[page] * pageSize + offset);
    }

    return 0;
}
