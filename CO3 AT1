#include <stdio.h>

int main() {
    int base, limit, logical, physical;

    printf("Enter Base Register: ");
    scanf("%d", &base);

    printf("Enter Limit Register: ");
    scanf("%d", &limit);

    printf("Enter Logical Address: ");
    scanf("%d", &logical);

    if (logical >= 0 && logical < limit) {
        physical = base + logical;
        printf("Valid Address\n");
        printf("Physical Address = %d\n", physical);
    } else {
        printf("Invalid Logical Address!\n");
    }

    return 0;
}
OUTPUT:
Enter Base Register: 1000
Enter Limit Register: 500
Enter Logical Address: 250

Valid Address
Physical Address = 1250
2.#include <stdio.h>

int main() {
    int pageTable[10];
    int n, page, offset, frame, pageSize, physical;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page size: ");
    scanf("%d", &pageSize);

    printf("Enter frame numbers for each page:\n");

    for (int i = 0; i < n; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d", &page);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (page >= n || offset >= pageSize) {
        printf("Invalid Address\n");
    } else {
        frame = pageTable[page];
        physical = frame * pageSize + offset;

        printf("Frame Number = %d\n", frame);
        printf("Physical Address = %d\n", physical);
    }

    return 0;
}

