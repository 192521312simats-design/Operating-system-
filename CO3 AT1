4.#include <stdio.h>

int main() {
    float memoryTime, tlbTime, hitRatio;
    float withoutTLB, withTLB;

    printf("Enter Memory Access Time (ns): ");
    scanf("%f", &memoryTime);

    printf("Enter TLB Access Time (ns): ");
    scanf("%f", &tlbTime);

    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);

    withoutTLB = 2 * memoryTime;

    withTLB = hitRatio * (tlbTime + memoryTime)
            + (1 - hitRatio) * (tlbTime + 2 * memoryTime);

    printf("\nMemory Access Time without TLB = %.2f ns\n", withoutTLB);
    printf("Effective Memory Access Time with TLB = %.2f ns\n", withTLB);

    return 0;
}
OUTPUT:
Enter Memory Access Time (ns): 100
Enter TLB Access Time (ns): 20
Enter TLB Hit Ratio (0 to 1): 0.9

Memory Access Time without TLB = 200.00 ns
Effective Memory Access Time with TLB = 130.00 ns

